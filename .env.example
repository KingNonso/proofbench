# ProofBench local configuration.
# Copy to .env for live-provider work. The five judge commands never need this file.
#
# NEVER commit a real key. .env is git-ignored; .env.example must stay empty of secrets.

# Live provider credentials are used only by the `-live` make targets.
# Offline replay, baseline validation, and evaluation must work with these unset.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional: override the sandbox container runtime host.
# DOCKER_HOST=
