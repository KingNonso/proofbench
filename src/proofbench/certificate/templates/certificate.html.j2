<!doctype html>
<meta charset="utf-8">
<title>Migration Change Certificate — {{ cert.case_id }}</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
  /* Local only: no remote fonts, scripts, or assets. The certificate must
     render identically on a machine with no network. */
  :root {
    --ink: #14181f; --muted: #5b6472; --rule: #d9dee6; --bg: #fbfcfd;
    --panel: #ffffff; --blocked: #a4262c; --ready: #0b6a35; --warn: #8a5a00;
  }
  * { box-sizing: border-box; }
  body { margin: 0; padding: 1.6rem; background: var(--bg); color: var(--ink);
         font: 15px/1.55 ui-sans-serif, -apple-system, "Segoe UI", Roboto, sans-serif; }
  main { max-width: 62rem; margin: 0 auto; }
  code, pre { font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace; font-size: .86em; }
  .screen { background: var(--panel); border: 1px solid var(--rule); border-radius: 10px;
            padding: 1.1rem 1.3rem; }
  .state { display: inline-block; font-weight: 700; letter-spacing: .04em;
           padding: .3rem .7rem; border-radius: 6px; color: #fff; font-size: 1.05rem; }
  .state.BLOCKED { background: var(--blocked); }
  .state.READY_FOR_REVIEW { background: var(--ready); }
  .state.DOMAIN_RULING_REQUIRED { background: var(--warn); }
  .state.EVIDENCE_INCOMPLETE { background: var(--muted); }
  h1 { font-size: 1.05rem; margin: 0 0 .8rem; color: var(--muted); font-weight: 600; }
  h2 { font-size: 1rem; margin: 1.8rem 0 .6rem; border-bottom: 1px solid var(--rule);
       padding-bottom: .3rem; }
  h3 { font-size: .92rem; margin: 1.1rem 0 .4rem; }
  dl { display: grid; grid-template-columns: max-content 1fr; gap: .35rem 1rem; margin: .9rem 0 0; }
  dt { color: var(--muted); }
  dd { margin: 0; }
  table { border-collapse: collapse; width: 100%; margin: .5rem 0; font-size: .9rem; }
  th, td { text-align: left; padding: .35rem .55rem; border-bottom: 1px solid var(--rule);
           vertical-align: top; }
  th { color: var(--muted); font-weight: 600; }
  td.num { text-align: right; }
  pre.replay { background: #10151c; color: #e6edf3; padding: .7rem .9rem; border-radius: 7px;
               overflow-x: auto; margin: .6rem 0 0; }
  .note { color: var(--muted); font-size: .88rem; }
  ol.timeline { padding-left: 1.2rem; }
  ol.timeline li { margin: .2rem 0; }
  .pass { color: var(--ready); font-weight: 600; }
  .fail { color: var(--blocked); font-weight: 600; }
</style>
<main>
  <!-- First screen: PRD-FR-060. All seven fields, no scrolling. -->
  <section class="screen">
    <h1>Migration Change Certificate — {{ cert.case_id }}: {{ cert.case_title }}</h1>
    <span class="state {{ cert.first_screen.external_state }}">{{ cert.first_screen.external_state }}</span>
    <dl>
      <dt>Candidate change</dt><dd>{{ cert.first_screen.candidate_change }}</dd>
      <dt>Decisive invariant</dt><dd><code>{{ cert.first_screen.decisive_invariant }}</code></dd>
      <dt>Confirmed blast radius</dt>
      <dd>
        {% if cert.first_screen.confirmed_blast_radius %}
        <table>
          <tr><th>Invariant</th><th>Role</th><th>Op</th><th>Affected tenant</th><th>Rows</th></tr>
          {% for item in cert.first_screen.confirmed_blast_radius %}
          <tr>
            <td><code>{{ item.invariant_id }}</code></td>
            <td><code>{{ item.role }}</code></td>
            <td>{{ item.operation }}</td>
            <td><code>{{ item.affected_tenant }}</code></td>
            <td class="num">{{ item.rows_affected }}</td>
          </tr>
          {% endfor %}
        </table>
        {% else %}<span class="note">Nothing confirmed.</span>{% endif %}
      </dd>
      <dt>Required action</dt><dd>{{ cert.first_screen.required_action }}</dd>
      <dt>Human ruling</dt><dd>{{ cert.first_screen.human_ruling or "none required" }}</dd>
    </dl>
    <pre class="replay">{{ cert.first_screen.replay_command }}</pre>
  </section>

  <h2>Decision</h2>
  <ul>{% for reason in cert.decision.reasons %}<li>{{ reason }}</li>{% endfor %}</ul>
  <p class="note">
    Decisive checks: <code>{{ cert.decision.decisive_check_ids | join(", ") or "none" }}</code>.
    Evidence complete: {{ "yes" if cert.decision.evidence_complete else "no" }}.
    Possible impact, not executed: {{ cert.decision.possible | length }}.
    Confirmed and possible are kept separate and never merged.
  </p>

  <h2>Visible tests</h2>
  <table>
    <tr><th>Check</th><th>Status</th><th>SQLSTATE</th></tr>
    {% for check in cert.visible_tests %}
    <tr>
      <td><code>{{ check.check_id }}</code></td>
      <td class="{{ 'pass' if check.status == 'passed' else 'fail' }}">{{ check.status }}</td>
      <td><code>{{ check.sqlstate or "—" }}</code></td>
    </tr>
    {% endfor %}
  </table>

  {% if cert.correction %}
  <h2>Proposed correction</h2>
  <p class="note">
    Proposed after the candidate was blocked. It does <strong>not</strong> change the
    decision above, which is about the candidate as submitted.
  </p>
  <table>
    <tr><th>Addresses</th><td><code>{{ cert.correction.addresses_invariants | join(", ") }}</code></td></tr>
    <tr><th>Verified by clean rerun</th>
        <td class="{{ 'pass' if cert.correction.verified else 'fail' }}">{{ "yes" if cert.correction.verified else "no" }}</td></tr>
    <tr><th>Regression check</th><td>{{ cert.correction.regression_check }}</td></tr>
    <tr><th>Rationale</th><td>{{ cert.correction.rationale }}</td></tr>
  </table>
  {% endif %}

  <h2>Worlds</h2>
  {% for result in cert.world_results %}
  <h3>{{ result.world }} — <span class="{{ 'pass' if result.status == 'passed' else 'fail' }}">{{ result.status }}</span></h3>
  <p class="note">
    Threatened: {{ result.threatened_invariants | join(", ") }} ·
    {{ result.checks | length }} checks ·
    digest <code>{{ result.semantic_digest[:16] }}</code>
  </p>
  {% for finding in result.findings %}
  <table>
    <tr><th>{{ finding.invariant_id }}</th><td>{{ finding.summary }}</td></tr>
    <tr><th>Expected</th><td>{{ finding.expected }}</td></tr>
    <tr><th>Observed</th><td>{{ finding.observed }}</td></tr>
  </table>
  {% endfor %}
  {% for failure in result.failures %}
  <p class="fail">Evidence failure in {{ failure.stage }}: {{ failure.reason }}</p>
  {% endfor %}
  {% endfor %}

  <h2>Trajectory</h2>
  <p class="note">
    {{ cert.trajectory.events }} events, root <code>{{ cert.trajectory.trace_root_hash[:16] }}</code>.
    Observable actions only; no hidden reasoning is recorded.
  </p>
  <ol class="timeline">
    {% for entry in cert.trajectory.narrative %}<li>{{ entry }}</li>{% endfor %}
  </ol>

  <h2>Environment</h2>
  <table>
    <tr><th>Python</th><td>{{ cert.environment.python_version }}</td></tr>
    <tr><th>Platform</th><td>{{ cert.environment.platform }}</td></tr>
    <tr><th>PostgreSQL image</th><td><code>{{ cert.environment.postgres_image }}</code></td></tr>
    <tr><th>Resolved image id</th><td><code>{{ cert.environment.resolved_image_id or "not recorded" }}</code></td></tr>
    <tr><th>Time zone</th><td>{{ cert.environment.timezone }}</td></tr>
    <tr><th>Inputs digest</th><td><code>{{ cert.inputs_digest }}</code></td></tr>
    <tr><th>Manifest</th><td><code>{{ cert.manifest_path }}</code></td></tr>
  </table>

  <h2>Known limits</h2>
  <ul>{% for limit in cert.known_limits %}<li>{{ limit }}</li>{% endfor %}</ul>
</main>
